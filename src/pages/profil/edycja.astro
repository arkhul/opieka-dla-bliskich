---
import CaregiverProfileForm from "@/components/caregiver/CaregiverProfileForm";
import Topbar from "@/components/Topbar.astro";
import Layout from "@/layouts/Layout.astro";
import { getOwnProfile } from "@/lib/services/caregiver.service";
import { listServices } from "@/lib/services/dictionary.service";
import { createClient } from "@/lib/supabase";
import type { OwnCaregiverProfileDto, ServiceDto } from "@/types";

// The form is pre-filled with the owner's contact data: never cache it in shared caches or keep it on disk.
Astro.response.headers.set("Cache-Control", "private, no-store");

// The middleware already sends anonymous users to sign in; this only narrows the type.
const { user } = Astro.locals;
if (!user) {
  return Astro.redirect("/auth/signin");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
let profile: OwnCaregiverProfileDto | null = null;
let services: ServiceDto[] = [];
let pageError: string | null = null;

if (!supabase) {
  pageError = "Supabase nie jest skonfigurowany — edycja profilu jest niedostępna.";
} else {
  try {
    const role = await Astro.locals.getRole();
    if (role !== "caregiver") {
      return Astro.redirect("/");
    }
    [profile, services] = await Promise.all([getOwnProfile(supabase, user.id), listServices(supabase)]);
  } catch {
    pageError = "Nie udało się wczytać formularza profilu. Odśwież stronę za chwilę.";
  }
}

const heading = profile ? "Edytuj profil" : "Utwórz profil";
---

<Layout title={heading}>
  <div class="bg-cosmic min-h-screen w-full p-4 sm:p-8">
    <Topbar />

    <div class="mx-auto w-full max-w-2xl rounded-2xl border border-white/10 bg-white/10 p-5 text-white backdrop-blur-xl sm:p-8">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        {heading}
      </h1>

      {pageError ? (
        <p class="rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">{pageError}</p>
      ) : (
        <CaregiverProfileForm
          initialProfile={profile}
          services={services}
          accountEmail={user.email ?? ""}
          client:load
        />
      )}

      {profile && (
        <p class="mt-4 text-center text-sm text-blue-100/60">
          <a href="/profil" class="text-purple-300 hover:underline">
            Wróć do profilu bez zapisywania
          </a>
        </p>
      )}
    </div>
  </div>
</Layout>
